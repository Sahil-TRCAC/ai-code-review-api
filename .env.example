SECRET_KEY=your-secret-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database
DATABASE_URL=postgres://user:password@localhost:5432/codereview

# Redis / Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
# Keep false so workers process reviews outside the HTTP request.
# Set true only when a test run should execute tasks inline.
CELERY_TASK_ALWAYS_EAGER=false
CELERY_TASK_EAGER_PROPAGATES=false
CELERY_BROKER_TRANSPORT=redis

# LLM Provider (groq, anthropic, or openai)
LLM_PROVIDER=groq
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=openai/gpt-oss-20b
ANTHROPIC_API_KEY=your-anthropic-api-key
OPENAI_API_KEY=your-openai-api-key

# JWT Settings
JWT_ACCESS_TOKEN_LIFETIME=60
JWT_REFRESH_TOKEN_LIFETIME=1440

# Rate Limiting
DAILY_REVIEW_LIMIT=10

# GitHub Webhook Secret
GITHUB_WEBHOOK_SECRET=your-github-webhook-secret

# Browser clients allowed to call the API
CORS_ALLOWED_ORIGINS=http://localhost:3000
